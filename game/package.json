{
  "name": "neon-coast",
  "version": "0.1.0",
  "private": true,
  "description": "Neon Coast: an original open-world driving game for the browser (Three.js + Rapier). Built by CATE agents.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "city:export": "node tools/export-city.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && vite build"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.11",
    "@types/three": "0.187.0",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.4.0",
    "vitest": "5.1.2"
  }
}
