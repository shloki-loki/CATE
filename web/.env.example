# Set these in Vercel > Project > Settings > Environment Variables. Never commit real values.
SITE_PASSWORD=          # the password you type to open the dashboard; make it long
GITHUB_TOKEN=           # fine-grained token for the CATE repo only: Contents read/write
GITHUB_REPO=shloki-loki/CATE
DATA_BRANCH=data
